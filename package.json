{
  "name": "the-crown",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "cd server && bun run dev",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "server:prepare": "cd server && bun install --frozen-lockfile && bun run prisma:generate",
    "server:check": "cd server && bun run typecheck",
    "server:migrate": "node scripts/migrate.mjs",
    "start": "bun run server:prepare && bun run server:check && bun run build && bun run server:migrate && cd server && bun run start"
  },
  "dependencies": {
    "@apollo/client": "^4.2.7",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-phantom": "^0.9.29",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-solflare": "^0.6.33",
    "@solana/web3.js": "^1.98.4",
    "@tailwindcss/vite": "^4.1.14",
    "buffer": "^6.0.3",
    "graphql": "^17.0.2",
    "liveline": "^0.0.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "pubkeyc": "^0.1.5",
    "railway": "^3.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7"
  },
  "patchedDependencies": {
    "liveline@0.0.7": "patches/liveline@0.0.7.patch"
  }
}
