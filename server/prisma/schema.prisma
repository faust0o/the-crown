// Prisma schema for the Casino GraphQL backend.
// Real package metrics (npm downloads + jsDelivr CDN hits) are ingested and
// persisted here; users/credits and the (simulated) prediction bets are
// persisted too. The live tick price + orderbook are simulated on the client
// and never stored.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BetStatus {
  OPEN
  WON
  LOST
  CASHED_OUT
  VOID // no decisive data point within 7 days of the round ending — stake refunded
}

/// A top-up: SOL paid on chain, credits granted here.
///
/// The signature is unique because it is the proof *and* the idempotency key.
/// Crediting a balance from a client's say-so would be a mint button; crediting
/// it from a transaction that can only be presented once is a purchase.
model CreditPurchase {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  signature   String   @unique
  lamports    BigInt
  credits     Int
  solPriceUsd Float
  at          DateTime @default(now())

  @@index([userId])
}

/// A (pseudonymous) player account with a fake credit balance.
model User {
  id           String      @id @default(cuid())
  handle       String      @unique
  credits      Int         @default(1000)
  /// A retired market-making desk rather than a person.
  ///
  /// Nothing sets this any more. The desks were removed when the board became
  /// player-priced, and the column stays because their accounts still stand
  /// behind the bets they placed in rounds that have already settled — dropping
  /// it would either orphan those rows or rewrite history to say a person made
  /// them. Everything player-facing still filters on it, so a desk account can
  /// never surface as a player or in the orders feed.
  isDesk       Boolean     @default(false)
  /// The Solana wallet this account signs in with, and the only thing that can.
  ///
  /// Nullable because the retired desks have none, and neither do the accounts
  /// that predate wallet login — they exist behind their settled bets and can
  /// no longer be signed into.
  ///
  /// Unique because it is the identity: two rows pointing at one wallet would be
  /// two accounts for one player, and a payout would reach whichever the login
  /// happened to find.
  walletAddress String?    @unique
  createdAt    DateTime    @default(now())

  sessions   Session[]
  cryptoBets CryptoBet[]
  purchases  CreditPurchase[]

  @@index([isDesk])
}

/// A live sign-in.
///
/// `token` is sha256 of the opaque bearer token the client holds, never the
/// token itself — see `hashToken` in src/auth.ts. The plaintext exists exactly
/// once, in the response to `walletLogin`, so a copy of this table lets nobody
/// impersonate anybody. Expired rows are swept hourly (src/sessions.ts).
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Crypto volume-rank markets: ten solana majors compete on trailing-window traded
// volume. A round asks, per coin, whether its rank at the cut is HIGHER, LOWER
// or the same (DRAW) as its rank when the round opened.
// ---------------------------------------------------------------------------

enum RoundStatus {
  OPEN // betting is live
  LOCKED // betting closed; the cut has not landed yet
  CUT // the cut instant passed and ranks were recorded; settling
  SETTLED // seed revealed, bets paid
}

enum RankDirection {
  HIGHER
  DRAW
  LOWER
}

/// One hour of competition.
///
/// The settlement instant ("the cut") is a random point inside the final
/// minute, so a pump timed at a known deadline can't decide the outcome. It is
/// committed up front: `commitHash` = sha256(seed) is published when the round
/// opens, `seed` is revealed at settlement, and cutAt is derived from the seed,
/// so anyone can verify the house didn't pick a convenient moment.
model Round {
  id               String      @id @default(cuid())
  startsAt         DateTime    @unique
  lockAt           DateTime // betting closes
  endsAt           DateTime // lockAt + the cut window
  commitHash       String // sha256(seed), published at open
  seed             String? // revealed at settlement
  cutAt            DateTime? // derived from seed; set when the cut lands
  /// The coin wearing the crown for this round: whoever finished #1 at the
  /// previous round's cut. It cannot be bet on — see rounds.ts.
  crownSymbol      String?
  /// The cut window this round actually used. Stored rather than read from env
  /// at display time: the cut instant is derived as HMAC(seed, id) mod this
  /// value, so a later config change would otherwise make settled rounds fail
  /// their own verification.
  cutWindowSeconds Int         @default(60)
  status           RoundStatus @default(OPEN)
  createdAt        DateTime    @default(now())

  entries RoundEntry[]
  bets    CryptoBet[]

  @@index([status])
}

/// A coin's standing in one round: where it started, and where it was at the cut.
model RoundEntry {
  id          String @id @default(cuid())
  round       Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  roundId     String
  symbol      String
  ticker      String
  startRank   Int
  startVolume Float
  cutRank     Int?
  cutVolume   Float?

  @@unique([roundId, symbol])
}

/// A three-way bet on one coin's rank movement over a round.
model CryptoBet {
  id         String        @id @default(cuid())
  /// The position account this bet lives in on-chain, when it was placed there.
  ///
  /// Null for every bet placed through the Postgres path. Where it is set the
  /// program holds the money and this row is an index: the stake, the price and
  /// the outcome are all readable from the account, and this row exists so the
  /// tape, the history and the round replay keep working unchanged.
  ///
  /// Unique because one account is one position. Two rows pointing at it would
  /// be two records of one bet, and settlement would pay one and strand the
  /// other.
  chainAddress String?     @unique
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  round      Round         @relation(fields: [roundId], references: [id], onDelete: Cascade)
  roundId    String
  symbol     String
  ticker     String
  direction  RankDirection
  stake      Int
  odds       Float // decimal multiplier locked at bet time
  startRank  Int
  status     BetStatus     @default(OPEN)
  cutRank    Int?
  payout     Int           @default(0)
  openedAt   DateTime      @default(now())
  resolvedAt DateTime?

  @@index([userId, status])
  @@index([roundId])
}

/// A token's display identity: what to call it and which mark to draw.
///
/// The oracle only ever holds the *current* trending pool in memory, so once a
/// token drops out of it there is nowhere left holding its logo — which made
/// old rounds replay as lettered discs, and put gaps in the live flow feed
/// whenever a mover had since fallen off the pool. Written whenever the upstream
/// reports something we haven't already stored, so it's one row per token ever
/// seen and almost never a write.
model Token {
  symbol    String   @id
  name      String
  imageUrl  String?
  updatedAt DateTime @updatedAt
}

/// A token's logo, held here so the board never waits on the host it came from.
///
/// Logos live on arweave, IPFS gateways and a long tail of issuer CDNs, and a
/// fifth of the board's were failing on any given load — gateways answering 429,
/// files served with no content type — while every new visitor made the proxy
/// fetch them all over again. Fetched once, in the background, when the oracle
/// first sees a token; served from here ever after. Postgres rather than a
/// volume because a Railway service with a volume cannot deploy without
/// downtime, and this one runs the game.
model TokenLogo {
  /// The upstream URL, exactly as the token's `imageUrl` names it.
  url         String   @id
  contentType String
  bytes       Bytes
  fetchedAt   DateTime @default(now())
}

/// One token's standing at one instant.
///
/// The oracle keeps a rolling window in memory for speed, but that dies with the
/// process — so a restart mid-round used to leave the chart starting from
/// whenever the server came back rather than from the round's open. Written only
/// when the upstream publishes new numbers, so this is roughly one row per token
/// per minute.
model RankSample {
  id     String   @id @default(cuid())
  at     DateTime
  symbol String
  rank   Int
  volume Float

  @@unique([at, symbol])
  @@index([at])
}
