# Copy to server/.env and fill in a Postgres connection string.
# Local:  postgresql://postgres:postgres@localhost:5432/casino?schema=public
# Neon:   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/casino?schema=public"

# Port the Apollo GraphQL server listens on (default 4000).
PORT=4000

# ---------------------------------------------------------------------------
# Production
# ---------------------------------------------------------------------------

# Set this in production. It is what turns on HSTS and `upgrade-insecure-requests`,
# turns *off* GraphQL introspection, the Apollo landing page and stack traces in
# error responses.
# NODE_ENV=production

# Comma-separated origins allowed to call the API from a browser.
# The SPA is served from this same origin in production, so this is for outside
# callers only — leaving it unset in production is correct and means "same-origin
# only". Dev (Vite on :5173) is allowed by default when NODE_ENV is not production.
CORS_ORIGINS="http://localhost:5173"

# How many reverse proxies sit in front of the server, for X-Forwarded-For.
# One on Railway. Must be a count, never `true`: with `true`, Express takes the
# left-most forwarded address — which the client controls — and every per-IP rate
# limit becomes trivially evadable. Defaults to 1 in production, 0 otherwise.
# TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Market
# ---------------------------------------------------------------------------

# Credits the opening auction stakes across one coin's three lines, split in
# proportion to the model's prior. This is the *only* number in the pricing, and
# with no market maker on the board it is the only thing between one player and
# the whole book: a line's mark is its share of this pool plus everything staked
# on it since, so this decides how many credits it takes to argue with the
# opening price. Raise it and the board is stickier; lower it and the first bet
# of a round swings it.
MARKET_OPENING_POOL=2000

# How far back the depth bars count, and at what resolution. A round, near
# enough — depth is the round's real traded interest, and there is no other
# flow to fill a shorter window.
# MARKET_BOOK_WINDOW_MS=1800000
# MARKET_DEPTH_BUCKET_MS=5000

# ---------------------------------------------------------------------------
# Oracle
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# Solana
# ---------------------------------------------------------------------------

# Whether the chain half of the game runs. Off is the shipping default: the
# database game works, and a flag means whatever misbehaves can be switched off
# by somebody who did not write it.
CHAIN_MODE=off

# The RPC the *server* uses. May carry a provider key — it never reaches the
# browser, which talks to this server's /rpc instead (see chain/rpc-proxy.ts).
SOLANA_RPC_URL="https://api.devnet.solana.com"

# What credits are priced at: SOL in dollars, read from Helius's `getAsset`.
# Left unset, this is `SOLANA_RPC_URL` with the host moved to mainnet — a price
# is a fact about a market and devnet has no market, so the price call goes to
# mainnet whichever chain the game itself runs on. Set it only when there is
# nothing to rewrite: a local validator, or an RPC that is not Helius.
# CROWN_PRICE_RPC_URL=""

# The SPL mint credits are denominated in. Written by `bun run chain:seed`.
CROWN_CREDIT_MINT=""

# Keys, as the key itself (JSON byte array or base58) or a path to one.
# On a laptop these default to ~/.config/solana/crown-devnet/*.json and can be
# left unset; a container has no such directory, so set them there.
#
#   CROWN_AUTHORITY_KEY  opens rounds, posts the board at the cut, reveals seeds,
#                        and funds the opening auction. Cannot move the vault.
#   CROWN_RELAYER_KEY    pays every fee and every position's rent, and is the key
#                        players name when they approve. Holds no credits.
CROWN_AUTHORITY_KEY=""
CROWN_RELAYER_KEY=""

# How much the house puts behind the book beyond the opening auctions. The book
# is not self-funding: an informed trader who buys a cheap leg that lands is paid
# out of this. Too small and settlement stops paying anybody.
CROWN_VAULT_BUFFER=500000000

# Where the balance checks in `chain:preflight` complain. The relayer's floor is
# set by how many positions are unsettled *at once* (~0.00195 SOL each), not by
# how fast anyone plays.
CROWN_RELAYER_FLOOR_SOL=0.5
CROWN_AUTHORITY_FLOOR_SOL=0.2

# ---------------------------------------------------------------------------
# Market data (Jupiter)
# ---------------------------------------------------------------------------

# Optional. Jupiter's token index answers without a key at 0.5 requests a
# second, which is plenty: it recomputes every ~15s and the oracle polls on that
# schedule (about four requests a minute). A free key from portal.jup.ag raises
# the limit to one a second; it does not make the data any fresher.
# JUPITER_API_KEY=""

# The volume window the board ranks by: 5m, 1h, 6h or 24h.
ORACLE_WINDOW="1h"

# The least liquidity a coin may have and still be raced. Jupiter's verified
# set decides what may be on the board at all; this decides whether its book is
# deep enough that its rank cannot simply be bought.
ORACLE_MIN_LIQUIDITY="250000"

# Symbols that cannot race and so are not in the field. Stablecoins and
# liquid-staking tokens are excluded by Jupiter's own tags and by shape as well.
ORACLE_EXCLUDE="SOL,WSOL,DAI,INF"

# The board's freshness is checked against mainnet's slot through the same
# Helius key as SOLANA_RPC_URL (rewritten to mainnet), or CROWN_PRICE_RPC_URL.
# Past ORACLE_STALE_AFTER_MS the board stops calling itself live and no round
# opens or cuts on it; a cut with no live reading within CUT_GRACE_SECONDS of its
# instant is refunded.
# ORACLE_STALE_AFTER_MS=120000
# CUT_GRACE_SECONDS=120
