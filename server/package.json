{
  "name": "utcc-casino-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env --import tsx --test src/*.test.ts src/*/*.test.ts",
    "nexus:reflect": "NEXUS_REFLECT=true node --import tsx src/schema/reflect.ts",
    "invites:mint": "node --env-file-if-exists=.env --import tsx src/mint-invites.ts",
    "prisma:generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "chain:seed": "node --env-file-if-exists=.env --import tsx src/chain/seed.ts",
    "chain:smoke": "node --env-file-if-exists=.env --import tsx src/chain/smoke.ts",
    "chain:wallet-check": "node --env-file-if-exists=.env --import tsx src/chain/wallet-check.ts",
    "chain:preflight": "node --env-file-if-exists=.env --import tsx src/chain/preflight-cli.ts",
    "chain:topup-check": "node --env-file-if-exists=.env --import tsx src/chain/topup-check.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@apollo/server": "^4.11.3",
    "@coral-xyz/anchor": "^0.32.1",
    "@prisma/client": "^6.2.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "graphql": "^16.10.0",
    "graphql-middleware": "^6.1.35",
    "graphql-scalars": "^1.24.0",
    "helmet": "^8.3.0",
    "nexus": "^1.3.0",
    "tsx": "^4.19.2",
    "tweetnacl": "^1.0.3",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "prisma": "^6.2.1",
    "typescript": "^5.7.3"
  }
}
